# 서버가 어느 모드로 동작하는지 나타냅니다. 현재 production 인증은 구현하지 않았습니다.
APP_MODE=demo

# 데모 모드에서 서버가 내부적으로 사용할 단일 사용자 식별자입니다.
DEMO_OWNER_ID=demo-user

# 로컬에서는 SQLite를 사용하고, 운영/Neon에서는 psycopg 형식의 PostgreSQL URL을 사용합니다.
DATABASE_URL=sqlite:///./washwise.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon CLI의 postgresql:// URL도 자동으로 psycopg 형식으로 처리합니다.
# 마이그레이션에는 pooler가 없는 직접 연결 URL을 사용합니다.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

# AI 담당자가 router를 제공한 뒤 연결할 때만 true로 바꿉니다.
ENABLE_AI_ROUTER=false

# AI 라우터를 켤 때만 서버 환경에 실제 키를 설정합니다. 키는 커밋하지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_VISION_API_KEY=

# 브라우저 기반 모바일 데모를 위한 CORS 허용 주소입니다.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081
